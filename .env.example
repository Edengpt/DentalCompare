# ============================================================
# DentalCompare - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Admin access (Phase 8) ---
# Comma-separated list of emails allowed into /admin (case-insensitive).
ADMIN_EMAILS=""

# --- Database (Phase 1) ---
# Local: postgresql://user:pass@localhost:5432/dentalcompare
# Hosted: Neon / Supabase / Vercel Postgres connection string
DATABASE_URL=""
DIRECT_URL=""

# --- Authentication: Clerk (Phase 3) ---
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- File Storage: AWS S3 or Cloudflare R2 (Phase 5) ---
# For R2, ENDPOINT is mandatory; for S3, omit it.
S3_REGION="auto"
S3_BUCKET="dentalcompare-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- Payments mode ---
# When "true" AND NODE_ENV is not "production", the full request flow runs
# end-to-end without charging (no real provider). Production ignores this flag.
PAYMENTS_TEST_MODE="true"

# --- Payments: PayPlus (patient one-time fees + clinic subscriptions) ---
# https://www.payplus.co.il / restapidev (sandbox) | restapi (prod)
PAYPLUS_API_BASE="https://restapidev.payplus.co.il/api/v1.0"
PAYPLUS_API_KEY=""
PAYPLUS_SECRET_KEY=""
PAYPLUS_PAYMENT_PAGE_UID=""        # the hosted payment-page profile uid
PAYPLUS_WEBHOOK_SECRET=""          # shared secret for IPN signature verification
PAYPLUS_WEBHOOK_HEADER=""          # optional: IPN signature header name (defaults to "hash")
CRON_SECRET=""                     # bearer token Vercel Cron sends; also used to guard the cron route

# --- Email: Resend (Phase 7) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DentalCompare Requests <requests@dentalcompare.co.il>"

# --- Rate Limiting: Upstash Redis (Phase 10) ---
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
