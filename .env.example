# ============================================================
# DentalCompare - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Admin access (Phase 8) ---
# Comma-separated list of emails allowed into /admin (case-insensitive).
ADMIN_EMAILS=""

# --- Database (Phase 1) ---
# Local: postgresql://user:pass@localhost:5432/dentalcompare
# Hosted: Neon / Supabase / Vercel Postgres connection string
DATABASE_URL=""
DIRECT_URL=""

# --- Authentication: Clerk (Phase 3) ---
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- File Storage: AWS S3 or Cloudflare R2 (Phase 5) ---
# For R2, ENDPOINT is mandatory; for S3, omit it.
S3_REGION="auto"
S3_BUCKET="dentalcompare-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# --- Payments: Stripe (Phase 6) ---
# https://dashboard.stripe.com/apikeys
# NOTE: Stripe isn't available to Israeli businesses. Leave these empty to run in
# PAYMENTS_TEST_MODE (the full flow works without charging), or wire a real
# provider later. Test mode is also forced on by PAYMENTS_TEST_MODE="true".
PAYMENTS_TEST_MODE="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email: Resend (Phase 7) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DentalCompare Requests <requests@dentalcompare.co.il>"

# --- Rate Limiting: Upstash Redis (Phase 10) ---
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
