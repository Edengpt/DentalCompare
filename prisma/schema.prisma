// DentalCompare - Database Schema (PRD Section 9)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The patient journey has no payment step (PRD 4.1), so there is no PAID state
// here. DRAFT covers everything before the patient presses send; SENT means at
// least one clinic was emailed.
enum RequestStatus {
  DRAFT
  SUBMITTED
  SENT
  FAILED
}

// Provider-neutral charge state. Used only by SubscriptionCharge — the patient
// Payment model was removed with the flat fee.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING // registered, awaiting admin approval
  TRIALING // inside the free trial — visible and receiving leads, not charged
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionProvider {
  PAYPLUS
  STRIPE
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  FEATURED
}

/// A country the platform operates in.
///
/// This model exists so that no country list is ever hardcoded again. Adding
/// Mexico is an admin action — one row — not a release. Everything that used to
/// be an Israeli constant (currency, calling code, the payer list) hangs off
/// here instead.
model Country {
  code          String   @id // ISO 3166-1 alpha-2: "IL", "TR", "HU"
  nameEn        String
  currency      String // ISO 4217: "ILS", "TRY", "EUR"
  callingCode   String // "972", "90", "36"
  defaultLocale String   @default("en")
  // Payers to offer in the clinic profile. Empty where the concept doesn't apply.
  insurers      String[]
  // Licence documents an admin must see before approving a clinic here. P2
  // consumes this; P0 only stores it, so the model doesn't have to change again.
  requiredDocs  String[]
  // New countries arrive as drafts. An admin flips this only once currency,
  // insurers and required documents are filled in — a half-configured country
  // must never reach users.
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dentists Dentist[]
  users    User[]

  @@index([isActive])
}

model User {
  id              String    @id @default(uuid())
  clerkUserId     String    @unique
  // Null when we genuinely do not know it. It used to fall back to the email
  // address, which meant a column named fullName quietly held something that is
  // not a name — and that value is shown to the dentist, on the quote page and
  // in the email asking them to price the work. Null is the honest answer, and
  // every reader already had to handle a missing patient (a deleted account),
  // so the display fallback existed before this column could use it.
  fullName        String?
  email           String    @unique
  // E.164 normalised (+9725XXXXXXXX) where possible. Stored whether or not it
  // has been verified — it's the only way a clinic can reach the patient, so an
  // unverified number still beats no number.
  //
  // Deliberately NOT unique. It was, while verification was mandatory ("one
  // account per real phone"). Now that verification is optional, a unique index
  // would let anyone typing someone else's number lock that person out of
  // signing up, while guarding nothing — an unverified number proves nothing.
  // If verification ever becomes mandatory again, re-add it as a PARTIAL unique
  // index over verified rows only.
  phone           String?
  phoneVerifiedAt DateTime?
  // Where the patient is. Defaults to IL so every existing row is correct the
  // moment the column exists; new sign-ups take it from the active locale.
  countryCode     String    @default("IL")
  country         Country   @relation(fields: [countryCode], references: [code])
  // Language for outgoing email. The site locale is in the URL, but a cron
  // sending a renewal notice at 4am has no request to read it from.
  locale          String    @default("he")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requests Request[]

  @@index([clerkUserId])
  @@index([countryCode])
}

model Dentist {
  id                  String   @id @default(uuid())
  clinicName          String
  dentistName         String
  email               String   @unique
  phone               String
  city                String
  address             String
  // Which country the clinic operates in. Drives its currency, its payer list
  // and which licence documents an admin must see before approving it.
  countryCode         String   @default("IL")
  country             Country  @relation(fields: [countryCode], references: [code])
  locale              String   @default("he")
  experienceYears     Int
  specialties         String[]
  treatments          String[]
  insurerAffiliations String[]
  // Languages the clinic's staff speak. A patient who can't be understood
  // won't fly, however good the price — so this is comparison data, not a
  // profile nicety. Lives on the clinic, not the quote: it doesn't change
  // between quotes, and duplicating it would let the two disagree.
  spokenLanguages     String[]
  profileImageUrl     String?
  rating              Float    @default(5.0)
  reviewCount         Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Self-registration + subscription contract (PRD: clinic onboarding)
  contactName     String? // person who completed the registration
  submittedBySelf Boolean   @default(false) // true for self-served clinic sign-ups awaiting approval
  agreedToTermsAt DateTime? // when the subscription contract was accepted
  termsVersion    String? // version of the contract that was accepted
  approvedAt      DateTime? // admin approval — starts the free trial clock (PRD 4.4)

  // The Clerk account that signs in as this clinic, stamped the first time
  // someone signs in holding a VERIFIED address matching `email`.
  //
  // Nullable because a clinic exists long before it has an account: it is born
  // from the public registration form, or from an admin who recruited it by
  // phone, and only later does a person sign in. Unique because one account
  // speaks for one clinic — two rows sharing it would make "which clinic am I"
  // unanswerable.
  clerkUserId String? @unique

  // When an admin actually looked at this clinic's licence documents, and who.
  //
  // Deliberately NOT approvedAt: that column records approval for listing and
  // starts the 60-day trial clock. One action producing two facts is not one
  // fact — sharing a column would mean never being able to answer "when was
  // this licence checked" without also answering "when did the money start".
  licenceVerifiedAt DateTime?
  licenceVerifiedBy String? // the admin's email

  // Bearer token emailed to a clinic whose document was rejected, so it can
  // upload a replacement without an account. P2b issues and consumes it.
  documentToken          String?   @unique
  documentTokenExpiresAt DateTime?

  requestDentists     RequestDentist[]
  subscription        ClinicSubscription?
  documents           ClinicDocument[]
  monthlyRequestUsage MonthlyRequestUsage[]

  @@index([city])
  @@index([isActive])
  @@index([submittedBySelf])
  @@index([clerkUserId])
}

/// עד לאן המטופל מוכן לנסוע — עבור הבקשה הזו.
///
/// על הבקשה ולא על המשתמש: אותו אדם יטוס בשביל שתי השתלות ולא בשביל סתימה.
/// זו תכונה של הטיפול, לא של האדם.
enum TravelScope {
  LOCAL // רק במדינה שלו
  SELECTED // מדינות שבחר במפורש
  ANY // כל מדינה פעילה — נקרא בזמן אמת, לא מוקפא
}

/// Which side of a treatment took an action.
enum TreatmentActor {
  PATIENT
  CLINIC
}

enum QuoteStatus {
  PENDING_DECISION
  APPROVED
  REJECTED
  IN_TREATMENT
  COMPLETION_REQUESTED
  COMPLETED
}

model Request {
  id                   String        @id @default(uuid())
  // Nullable so deleting a user (Clerk user.deleted) preserves the request as a
  // financial/audit record instead of cascading it away. Readers must treat a
  // null user as "deleted patient".
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  treatmentFileUrl     String
  xrayFileUrl          String
  patientNotes         String?       @db.Text
  status               RequestStatus @default(DRAFT)
  sentAt               DateTime?
  travelScope          TravelScope   @default(LOCAL)
  /// In use only when travelScope = SELECTED; empty otherwise.
  destinationCountries String[]
  /// Explicit consent to send health data to the chosen clinics and to store it
  /// in the United States. Null means not yet given, and sending is blocked.
  /// The version is kept alongside the timestamp because consent without the
  /// wording it was given to proves nothing — same pattern as the clinic's
  /// agreedToTermsAt / termsVersion.
  consentAt            DateTime?
  consentVersion       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  requestDentists RequestDentist[]

  @@index([userId])
  @@index([status])
}

/// A licence (or insurance, or whatever else a country asks for) document a
/// clinic handed over at registration.
///
/// One row per (clinic, kind): a re-upload REPLACES the row and deletes the old
/// object from storage, and the history lives in auditLog where it belongs. A
/// row per upload would make "which document is current" a query instead of a
/// fact, and every reader would have to get that query right.
model ClinicDocument {
  id              String    @id @default(uuid())
  dentistId       String
  dentist         Dentist   @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  /// As written in Country.requiredDocs, or "licence" when that list is empty.
  kind            String
  /// Private blob store — the same one the patients' x-rays live in, never the
  /// public store the clinic logos use.
  blobUrl         String
  contentType     String
  uploadedAt      DateTime  @default(now())
  /// null = fine. A rejected document is waiting for a replacement, and the
  /// reason is what gets written to the clinic. P2b sets these.
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  @@unique([dentistId, kind])
  @@index([dentistId])
}

model RequestDentist {
  id        String    @id @default(uuid())
  requestId String
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  dentistId String
  dentist   Dentist   @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  emailSent Boolean   @default(false)
  sentAt    DateTime?

  quoteToken String? @unique // per-recipient magic-link token for the quote form
  quote      Quote?

  // Invalid-lead report (PRD 4.5). There are no credits to refund under a
  // subscription, so compensation is subscription days; this pair exists to
  // measure the disputed-lead rate, which is the leading churn indicator.
  disputedAt    DateTime?
  disputeReason String?   @db.Text

  @@unique([requestId, dentistId])
  @@index([dentistId])
  @@index([dentistId, sentAt]) // duplicate-lead lookback for the same clinic
}

model Quote {
  id               String         @id @default(uuid())
  requestDentistId String         @unique
  requestDentist   RequestDentist @relation(fields: [requestDentistId], references: [id], onDelete: Cascade)
  // Money is an integer count of minor units plus an ISO 4217 code. The pair is
  // the unit — a bare number is meaningless once more than one currency exists.
  amountMinor      Int?
  currency         String?
  note             String?        @db.Text // free-text, e.g. "כולל צילום, לא כולל שתל"

  // --- Cross-border comparison ---
  //
  // Across borders the price alone lies: 3,200 over two trips costs more than
  // 4,000 over one, once flights and time off work are counted. These are the
  // dimensions that make the comparison honest. Defaults keep every existing
  // single-country quote valid without a backfill.

  /// What the price covers. Canonical keys (QUOTE_INCLUSIONS); labels live in
  /// the i18n layer so they translate with the rest of the site.
  includes                      String[]
  /// How many nights of accommodation the price covers. Meaningful only when
  /// `includes` contains "ACCOMMODATION" — forced null otherwise, the same
  /// rule `weeksBetweenTrips` already follows relative to `tripsRequired`.
  accommodationNights           Int?
  /// How many separate trips abroad the treatment needs. Implants routinely
  /// need two, months apart — the single biggest hidden cost.
  tripsRequired                 Int         @default(1)
  daysPerTrip                   Int         @default(1)
  /// Null when one trip is enough.
  weeksBetweenTrips             Int?
  /// How many separate times the patient must physically be at the clinic —
  /// independent of tripsRequired. A local patient has sessions with zero
  /// trips; an implant abroad needs both a trip count and a session count,
  /// and they are not always equal (a clinic could schedule two sessions
  /// inside one trip).
  sessionsRequired               Int         @default(1)
  /// Null when one session is enough. Forced null otherwise, same rule as
  /// weeksBetweenTrips.
  weeksBetweenSessions           Int?
  /// The dominant fear for a dental-tourism patient: what happens when
  /// something goes wrong after they have flown home.
  warrantyYears                 Int?
  warrantyNote                  String?     @db.Text
  // When the patient "you got a new quote" email was successfully sent. Null =
  // not yet notified (first send failed) — the retry cron picks these up.
  patientNotifiedAt             DateTime?
  status                        QuoteStatus @default(PENDING_DECISION)
  decidedAt                     DateTime?
  rejectedAuto                  Boolean     @default(false)
  treatmentStartedAt            DateTime?
  /// Who marked the start — either side may. Decides who the "treatment
  /// started" email goes to (the other party), including on a cron retry.
  /// Null on rows from before the patient could mark it: those were the clinic.
  treatmentStartedBy            TreatmentActor?
  completionRequestedAt         DateTime?
  /// The patient answered a completion request with "still ongoing". The quote
  /// went back to IN_TREATMENT; the clinic may ask again later.
  completionDeclinedAt          DateTime?
  completionDeclinedNotifiedAt  DateTime?
  completedAt                   DateTime?
  decisionNotifiedAt            DateTime?
  treatmentStartedNotifiedAt    DateTime?
  completionRequestedNotifiedAt DateTime?
  completedNotifiedAt           DateTime?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  @@index([requestDentistId])
  @@index([status])
}

// The Payment model (patient flat fee) was removed with the free-patient pivot.
// Clinic money lives in ClinicSubscription + SubscriptionCharge only.

/// One row per (payment provider, tier) pair. Eden edits monthlyPriceMinor,
/// yearlyPriceMinor, monthlyRequestCap and trialRequestCap from the admin
/// panel — currency is fixed per provider and never exposed for editing. A
/// price change here affects only a subscription created AFTER the change;
/// ClinicSubscription snapshots its own price at creation.
model SubscriptionPricing {
  provider          SubscriptionProvider
  // The tier this row prices. FREE is locked to 0/0 by parsePricingInput
  // (Task 2), not just convention. trialDays stays the live calendar-trial
  // source for every tier until the outcome-based-trial plan replaces it;
  // trialRequestCap is present and editable now but unread until then.
  tier              SubscriptionTier
  currency          String
  monthlyPriceMinor Int
  yearlyPriceMinor  Int
  // null = unlimited (FEATURED). Unread by any query until the request-cap
  // enforcement plan.
  monthlyRequestCap Int?
  trialDays         Int
  trialRequestCap   Int
  updatedAt         DateTime             @updatedAt
  updatedBy         String?

  @@id([provider, tier])
}

model ClinicSubscription {
  id                      String               @id @default(uuid())
  dentistId               String               @unique
  dentist                 Dentist              @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan
  status                  SubscriptionStatus   @default(PENDING)
  // Money is an integer count of minor units plus an ISO 4217 code. The pair is
  // the unit — a bare number is meaningless once more than one currency exists.
  priceMinor              Int
  currency                String
  // Which payment provider this clinic is billed through, decided once at
  // registration from Dentist.countryCode (IL -> PAYPLUS, else STRIPE) and
  // never re-derived. PayPlus's cron-driven renewal engine and Stripe's own
  // webhook-driven one are completely separate — this field is how every
  // query and cron tells them apart.
  //
  // Unlike priceMinor/currency/trialDays (which dropped their defaults so a
  // missing value fails loudly), this keeps @default(PAYPLUS) permanently:
  // every one of this codebase's dozens of existing ClinicSubscription test
  // fixtures genuinely IS a PayPlus subscription (Israeli test data,
  // ILS pricing) — the default states that historical fact rather than
  // papering over an unknown one, and every real write path this plan adds
  // (Task 3's createPendingSubscription, Task 4's registerClinic) always
  // passes provider explicitly regardless, so production code never leans
  // on the default at all.
  provider                SubscriptionProvider @default(PAYPLUS)
  // Which pricing tier this clinic is on. Defaulted to BASIC, not FREE, for
  // the exact reason `provider` above defaults to PAYPLUS: every row created
  // before this field existed — and every write path this plan doesn't touch
  // yet — genuinely IS the one paid plan that existed before tiers did.
  tier                    SubscriptionTier     @default(BASIC)
  // The lifetime request threshold that converts this trial to a paid
  // subscription, frozen at registration from SubscriptionPricing.trialRequestCap
  // the same way priceMinor/currency/trialDays already are. Defaulted to 5 (not
  // dropped) because unrelated test fixtures across the repo construct
  // ClinicSubscription rows directly and have no reason to know about this —
  // the two real write paths (clinic-registration.ts, admin-actions.ts) pass it
  // explicitly regardless, so production code never leans on the default.
  trialRequestCap         Int                  @default(5)
  // Frozen at registration from SubscriptionPricing.monthlyRequestCap for the
  // clinic's (provider, tier) — never re-read live. null = unlimited
  // (FEATURED). Unlike trialRequestCap this needs no @default: it's
  // genuinely, correctly nullable (not a "fail loud if missing" field), so
  // the unrelated test fixtures across the repo that construct
  // ClinicSubscription directly simply get null, which every check this
  // plan adds already treats as "never at cap" — the same safe value
  // FEATURED clinics get on purpose.
  monthlyRequestCap       Int?
  // Lifetime count of requests actually delivered to this clinic — the trigger
  // for the outcome-based trial. Distinct from MonthlyRequestUsage below, which
  // resets every calendar month and exists for the request-cap plan, not this
  // one; both counters grow on the same event (see request-usage.ts, Task 3).
  verifiedRequestCount    Int                  @default(0)
  // The trial length in effect when this clinic registered, frozen the same way
  // priceMinor/currency are. Without this, approveClinic would read whatever
  // SubscriptionPricing.trialDays says *at approval time* — which could differ
  // from what the clinic actually saw and agreed to at registration, with
  // nothing recording which one it was.
  trialDays               Int
  setupToken              String               @unique
  recurringToken          String? // PayPlus stored-card token uid (set after first paid charge)
  payplusCustomerUid      String?
  pageRequestUid          String? // PayPlus page_request_uid of the setup charge, for return-page verification
  // Stripe's own identifiers for this subscription. Set once, from the first
  // webhook event (checkout.session.completed) that confirms Checkout finished.
  stripeCustomerId        String?
  stripeSubscriptionId    String?              @unique
  // End of the free trial (approvedAt + TRIAL_DAYS). While TRIALING the clinic is
  // fully visible and receives leads; the renewal cron runs the first real charge
  // once this passes.
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  lastChargeAt            DateTime?
  canceledAt              DateTime?
  // When the "your charge failed" email was last sent, so PAST_DUE clinics are
  // notified once (not every day the retry cron runs). Cleared on a paid charge.
  paymentFailedNotifiedAt DateTime?
  // Smallest "days remaining" warning already emailed for this trial (see
  // TRIAL_WARNING_DAYS_BEFORE), so each warning goes out at most once.
  trialWarningSentDays    Int?
  // When the trial ran out with no way to charge — PayPlus unconfigured, or the
  // clinic never stored a card. The clinic deliberately stays TRIALING and stays
  // visible; this stamp is the only record that its free period is over, and the
  // reason the admin screen can show it and the alert email fires exactly once.
  // Status is not used for this: a new SubscriptionStatus missing from either
  // visibleSubscriptionFilter or isClinicVisible drops a clinic from the
  // directory with no error anywhere.
  trialEndedUnbilledAt    DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  charges SubscriptionCharge[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
}

/// How many requests a clinic has actually received in one calendar month.
/// Unread by any query until the request-cap-enforcement plan — this table
/// exists now only so the counter isn't lost between when it starts being
/// collected (this plan) and when it starts being enforced (a later one).
model MonthlyRequestUsage {
  dentistId String
  dentist   Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  // "2026-09" — a natural key that resets the count every month without a
  // separate cron job to zero it out.
  yearMonth String
  count     Int     @default(0)

  @@id([dentistId, yearMonth])
}

/// Daily FX snapshot, for DISPLAY conversion only.
///
/// A quote is always stored in the currency the clinic named. Converting at
/// save time would commit the platform to a price it doesn't control, so these
/// rates never touch a stored amount — they only render one in the reader's
/// currency, labelled with the date they were fetched.
model ExchangeRate {
  base      String // "EUR"
  quote     String // "ILS"
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime

  @@id([base, quote])
}

model RateLimit {
  id        String   @id @default(uuid())
  bucket    String // e.g. "clinic-join:<ip>", "quote:<token>", "upload:<requestId>"
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String // admin email, or "system" / "webhook" for automated actors
  action    String // e.g. "clinic.approve", "request.fulfilled", "subscription.canceled"
  entity    String // model name, e.g. "Dentist", "Request", "ClinicSubscription"
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model SubscriptionCharge {
  id                    String             @id @default(uuid())
  subscriptionId        String
  subscription          ClinicSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Money is an integer count of minor units plus an ISO 4217 code. The pair is
  // the unit — a bare number is meaningless once more than one currency exists.
  amountMinor           Int
  currency              String
  status                PaymentStatus      @default(PENDING)
  payplusTransactionUid String?            @unique
  stripeInvoiceId       String?            @unique
  periodStart           DateTime
  periodEnd             DateTime
  paidAt                DateTime?
  createdAt             DateTime           @default(now())

  @@index([subscriptionId])
}
