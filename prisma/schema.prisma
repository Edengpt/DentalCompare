// DentalCompare - Database Schema (PRD Section 9)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The patient journey has no payment step (PRD 4.1), so there is no PAID state
// here. DRAFT covers everything before the patient presses send; SENT means at
// least one clinic was emailed.
enum RequestStatus {
  DRAFT
  SUBMITTED
  SENT
  FAILED
}

// Provider-neutral charge state. Used only by SubscriptionCharge — the patient
// Payment model was removed with the flat fee.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING // registered, awaiting admin approval
  TRIALING // inside the free trial — visible and receiving leads, not charged
  ACTIVE
  PAST_DUE
  CANCELED
}

/// A country the platform operates in.
///
/// This model exists so that no country list is ever hardcoded again. Adding
/// Mexico is an admin action — one row — not a release. Everything that used to
/// be an Israeli constant (currency, calling code, the payer list) hangs off
/// here instead.
model Country {
  code          String   @id // ISO 3166-1 alpha-2: "IL", "TR", "HU"
  nameEn        String
  currency      String // ISO 4217: "ILS", "TRY", "EUR"
  callingCode   String // "972", "90", "36"
  defaultLocale String   @default("en")
  // Payers to offer in the clinic profile. Empty where the concept doesn't apply.
  insurers      String[]
  // Licence documents an admin must see before approving a clinic here. P2
  // consumes this; P0 only stores it, so the model doesn't have to change again.
  requiredDocs  String[]
  // New countries arrive as drafts. An admin flips this only once currency,
  // insurers and required documents are filled in — a half-configured country
  // must never reach users.
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dentists Dentist[]
  users    User[]

  @@index([isActive])
}

model User {
  id              String    @id @default(uuid())
  clerkUserId     String    @unique
  // Null when we genuinely do not know it. It used to fall back to the email
  // address, which meant a column named fullName quietly held something that is
  // not a name — and that value is shown to the dentist, on the quote page and
  // in the email asking them to price the work. Null is the honest answer, and
  // every reader already had to handle a missing patient (a deleted account),
  // so the display fallback existed before this column could use it.
  fullName        String?
  email           String    @unique
  // E.164 normalised (+9725XXXXXXXX) where possible. Stored whether or not it
  // has been verified — it's the only way a clinic can reach the patient, so an
  // unverified number still beats no number.
  //
  // Deliberately NOT unique. It was, while verification was mandatory ("one
  // account per real phone"). Now that verification is optional, a unique index
  // would let anyone typing someone else's number lock that person out of
  // signing up, while guarding nothing — an unverified number proves nothing.
  // If verification ever becomes mandatory again, re-add it as a PARTIAL unique
  // index over verified rows only.
  phone           String?
  phoneVerifiedAt DateTime?
  // Where the patient is. Defaults to IL so every existing row is correct the
  // moment the column exists; new sign-ups take it from the active locale.
  countryCode     String    @default("IL")
  country         Country   @relation(fields: [countryCode], references: [code])
  // Language for outgoing email. The site locale is in the URL, but a cron
  // sending a renewal notice at 4am has no request to read it from.
  locale          String    @default("he")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requests Request[]

  @@index([clerkUserId])
  @@index([countryCode])
}

model Dentist {
  id                  String   @id @default(uuid())
  clinicName          String
  dentistName         String
  email               String   @unique
  phone               String
  city                String
  address             String
  // Which country the clinic operates in. Drives its currency, its payer list
  // and which licence documents an admin must see before approving it.
  countryCode         String   @default("IL")
  country             Country  @relation(fields: [countryCode], references: [code])
  locale              String   @default("he")
  experienceYears     Int
  specialties         String[]
  treatments          String[]
  insurerAffiliations String[]
  // Languages the clinic's staff speak. A patient who can't be understood
  // won't fly, however good the price — so this is comparison data, not a
  // profile nicety. Lives on the clinic, not the quote: it doesn't change
  // between quotes, and duplicating it would let the two disagree.
  spokenLanguages     String[]
  profileImageUrl     String?
  rating              Float    @default(5.0)
  reviewCount         Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Self-registration + subscription contract (PRD: clinic onboarding)
  contactName     String? // person who completed the registration
  submittedBySelf Boolean   @default(false) // true for self-served clinic sign-ups awaiting approval
  agreedToTermsAt DateTime? // when the subscription contract was accepted
  termsVersion    String? // version of the contract that was accepted
  approvedAt      DateTime? // admin approval — starts the free trial clock (PRD 4.4)

  requestDentists RequestDentist[]
  subscription    ClinicSubscription?

  @@index([city])
  @@index([isActive])
  @@index([submittedBySelf])
}

/// עד לאן המטופל מוכן לנסוע — עבור הבקשה הזו.
///
/// על הבקשה ולא על המשתמש: אותו אדם יטוס בשביל שתי השתלות ולא בשביל סתימה.
/// זו תכונה של הטיפול, לא של האדם.
enum TravelScope {
  LOCAL // רק במדינה שלו
  SELECTED // מדינות שבחר במפורש
  ANY // כל מדינה פעילה — נקרא בזמן אמת, לא מוקפא
}

model Request {
  id               String        @id @default(uuid())
  // Nullable so deleting a user (Clerk user.deleted) preserves the request as a
  // financial/audit record instead of cascading it away. Readers must treat a
  // null user as "deleted patient".
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  treatmentFileUrl String
  xrayFileUrl      String
  patientNotes     String?       @db.Text
  status           RequestStatus @default(DRAFT)
  sentAt           DateTime?
  travelScope          TravelScope @default(LOCAL)
  /// In use only when travelScope = SELECTED; empty otherwise.
  destinationCountries String[]
  /// Explicit consent to send health data to the chosen clinics and to store it
  /// in the United States. Null means not yet given, and sending is blocked.
  /// The version is kept alongside the timestamp because consent without the
  /// wording it was given to proves nothing — same pattern as the clinic's
  /// agreedToTermsAt / termsVersion.
  consentAt            DateTime?
  consentVersion       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  requestDentists RequestDentist[]

  @@index([userId])
  @@index([status])
}

model RequestDentist {
  id        String    @id @default(uuid())
  requestId String
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  dentistId String
  dentist   Dentist   @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  emailSent Boolean   @default(false)
  sentAt    DateTime?

  quoteToken String? @unique // per-recipient magic-link token for the quote form
  quote      Quote?

  // Invalid-lead report (PRD 4.5). There are no credits to refund under a
  // subscription, so compensation is subscription days; this pair exists to
  // measure the disputed-lead rate, which is the leading churn indicator.
  disputedAt    DateTime?
  disputeReason String?   @db.Text

  @@unique([requestId, dentistId])
  @@index([dentistId])
  @@index([dentistId, sentAt]) // duplicate-lead lookback for the same clinic
}

model Quote {
  id               String         @id @default(uuid())
  requestDentistId String         @unique
  requestDentist   RequestDentist @relation(fields: [requestDentistId], references: [id], onDelete: Cascade)
  // Money is an integer count of minor units plus an ISO 4217 code. The pair is
  // the unit — a bare number is meaningless once more than one currency exists.
  amountMinor      Int?
  currency         String?
  note             String?        @db.Text // free-text, e.g. "כולל צילום, לא כולל שתל"

  // --- Cross-border comparison ---
  //
  // Across borders the price alone lies: 3,200 over two trips costs more than
  // 4,000 over one, once flights and time off work are counted. These are the
  // dimensions that make the comparison honest. Defaults keep every existing
  // single-country quote valid without a backfill.

  /// What the price covers. Canonical keys (QUOTE_INCLUSIONS); labels live in
  /// the i18n layer so they translate with the rest of the site.
  includes          String[]
  /// How many separate trips abroad the treatment needs. Implants routinely
  /// need two, months apart — the single biggest hidden cost.
  tripsRequired     Int       @default(1)
  daysPerTrip       Int       @default(1)
  /// Null when one trip is enough.
  weeksBetweenTrips Int?
  /// The dominant fear for a dental-tourism patient: what happens when
  /// something goes wrong after they have flown home.
  warrantyYears     Int?
  warrantyNote      String?   @db.Text
  // When the patient "you got a new quote" email was successfully sent. Null =
  // not yet notified (first send failed) — the retry cron picks these up.
  patientNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([requestDentistId])
}

// The Payment model (patient flat fee) was removed with the free-patient pivot.
// Clinic money lives in ClinicSubscription + SubscriptionCharge only.

model ClinicSubscription {
  id                      String             @id @default(uuid())
  dentistId               String             @unique
  dentist                 Dentist            @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  plan                    SubscriptionPlan
  status                  SubscriptionStatus @default(PENDING)
  // Money is an integer count of minor units plus an ISO 4217 code. The pair is
  // the unit — a bare number is meaningless once more than one currency exists.
  priceMinor              Int
  currency                String
  setupToken              String             @unique
  recurringToken          String? // PayPlus stored-card token uid (set after first paid charge)
  payplusCustomerUid      String?
  pageRequestUid          String? // PayPlus page_request_uid of the setup charge, for return-page verification
  // End of the free trial (approvedAt + TRIAL_DAYS). While TRIALING the clinic is
  // fully visible and receives leads; the renewal cron runs the first real charge
  // once this passes.
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  lastChargeAt            DateTime?
  canceledAt              DateTime?
  // When the "your charge failed" email was last sent, so PAST_DUE clinics are
  // notified once (not every day the retry cron runs). Cleared on a paid charge.
  paymentFailedNotifiedAt DateTime?
  // Smallest "days remaining" warning already emailed for this trial (see
  // TRIAL_WARNING_DAYS_BEFORE), so each warning goes out at most once.
  trialWarningSentDays    Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  charges SubscriptionCharge[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
}

/// Daily FX snapshot, for DISPLAY conversion only.
///
/// A quote is always stored in the currency the clinic named. Converting at
/// save time would commit the platform to a price it doesn't control, so these
/// rates never touch a stored amount — they only render one in the reader's
/// currency, labelled with the date they were fetched.
model ExchangeRate {
  base      String // "EUR"
  quote     String // "ILS"
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime

  @@id([base, quote])
}

model RateLimit {
  id        String   @id @default(uuid())
  bucket    String // e.g. "clinic-join:<ip>", "quote:<token>", "upload:<requestId>"
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String // admin email, or "system" / "webhook" for automated actors
  action    String // e.g. "clinic.approve", "request.fulfilled", "subscription.canceled"
  entity    String // model name, e.g. "Dentist", "Request", "ClinicSubscription"
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model SubscriptionCharge {
  id                    String             @id @default(uuid())
  subscriptionId        String
  subscription          ClinicSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Money is an integer count of minor units plus an ISO 4217 code. The pair is
  // the unit — a bare number is meaningless once more than one currency exists.
  amountMinor           Int
  currency              String
  status                PaymentStatus      @default(PENDING)
  payplusTransactionUid String?            @unique
  periodStart           DateTime
  periodEnd             DateTime
  paidAt                DateTime?
  createdAt             DateTime           @default(now())

  @@index([subscriptionId])
}
